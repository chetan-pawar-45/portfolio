# ═══════════════════════════════════════════════
#  PORTFOLIO BACKEND — Environment Variables
# ═══════════════════════════════════════════════

# Server
PORT=3000
NODE_ENV=development

# MongoDB connection string
# Local:   mongodb://localhost:27017/portfolio
# Atlas:   mongodb+srv://<user>:<pass>@cluster.xxxxx.mongodb.net/portfolio
MONGO_URI=mongodb://localhost:27017/portfolio

# Email (Nodemailer) — use Gmail App Password or SMTP provider
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_TO=chetanpawar0780@gmail.com
